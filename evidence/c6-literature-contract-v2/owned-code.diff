+def frozen_upstream_sources(project_root: Path | None = None) -> dict[str, str]:
+    """Authenticate the immutable acquisition manifest and all 35 source files.
+
+    Expected bytes come from a fixed external manifest pin, not a caller-supplied
+    rehash. This returns paths for a separate reference archive/freeze inventory.
+    Neither changed source nor an alternative acquisition manifest is accepted.
+    """
+    root = Path(project_root or Path(__file__).resolve().parents[1])
+    if root.is_symlink():
+        raise ValueError("Pinned upstream project root cannot be a symlink")
+    root = root.resolve()
+    manifest_path = root / "references/manifest.json"
+    if manifest_path.is_symlink() or _file_hash(manifest_path) != UPSTREAM_MANIFEST_SHA256:
+        raise ValueError("Upstream acquisition manifest differs from its external fixed SHA-256")
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if (manifest.get("upstream_repo") != "https://github.com/SamuelSchmidgall/AgentLaboratory"
+            or manifest.get("upstream_commit") != UPSTREAM_COMMIT):
+        raise ValueError("Pinned upstream repository or commit differs")
+    entries = [entry for entry in manifest["files"] if "upstream_path" in entry]
+    if len(entries) != 35:
+        raise ValueError("Pinned acquisition must inventory exactly 35 upstream files")
+    snapshot = root / "references/upstream" / ("AgentLaboratory-" + UPSTREAM_COMMIT)
+    result = {str(manifest_path): UPSTREAM_MANIFEST_SHA256}
+    for entry in entries:
+        relative = PurePosixPath(entry["upstream_path"])
+        if (relative.is_absolute() or ".." in relative.parts or not relative.parts
+                or relative.as_posix() != entry["upstream_path"] or "\\" in entry["upstream_path"]
+                or ":" in entry["upstream_path"]):
+            raise ValueError("Pinned upstream source path is invalid")
+        path = snapshot / Path(*relative.parts)
+        if (path.is_symlink() or not path.resolve().is_relative_to(snapshot.resolve())
+                or path.resolve() != (root / entry["path"]).resolve()):
+            raise ValueError("Pinned upstream source path escapes or disagrees with its manifest")
+        ancestor = path.parent
+        while ancestor != root:
+            if ancestor.is_symlink():
+                raise ValueError("Pinned upstream source parent cannot be a symlink")
+            ancestor = ancestor.parent
+        raw = path.read_bytes()
+        blob = b"blob " + str(len(raw)).encode("ascii") + b"\0" + raw
+        if (len(raw) != entry["bytes"] or hashlib.sha256(raw).hexdigest() != entry["sha256"]
+                or hashlib.sha1(blob).hexdigest() != entry["git_blob_sha1"]):
+            raise ValueError("Pinned upstream source bytes changed: " + relative.as_posix())
+        if str(path) in result:
+            raise ValueError("Pinned acquisition inventory contains repeated paths")
+        result[str(path)] = entry["sha256"]
+    for name, expected in UPSTREAM_MODULE_SHA256.items():
+        if result.get(str(snapshot / (name + ".py"))) != expected:
+            raise ValueError("Executable upstream source differs from the independent module pin")
+    return result
+
